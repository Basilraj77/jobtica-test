# Environment configuration example for Vercel + Supabase

# -----------------------------
# Supabase (server-side)
# Use SUPABASE_SERVICE_ROLE_KEY only on the server (kept secret)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------
# Supabase (client-side - exposed to the browser)
# Vite will expose variables prefixed with VITE_
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------
# Node / Server settings
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://your-vercel-deployment.vercel.app

# Session
SESSION_SECRET=your-session-secret

# Notes:
# - Do NOT commit secrets to git. On Vercel set the SUPABASE_SERVICE_ROLE_KEY
#   and VITE_SUPABASE_ANON_KEY values in the Project > Settings > Environment Variables.
# - Use the ANON key (VITE_SUPABASE_ANON_KEY) for client-side SDK usage.
# - Use SUPABASE_SERVICE_ROLE_KEY only on the server (api) for privileged operations.